# 고려솔더 AI 스마트공장 — 환경변수
#
#   cp .env.example .env  후 값을 채운다.  .env 는 커밋하지 않는다.
#
# ⚠ 키 값은 로그·응답·예외 메시지 어디에도 실리지 않는다 (agent-architecture.md §2.9).
#   `GET /api/v1/agents/health` 는 "설정됐는가" 만 돌려주고 앞자리·길이도 내지 않는다.

# ── DB ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://localhost/koryo_solder_db

# ── 인증 ────────────────────────────────────────────────────────────────
# 🔴 배포 전에 반드시 바꾼다. 기본값이 코드에 박혀 있다 (src/api/deps.py).
JWT_SECRET_KEY=

# ══════════════════════════════════════════════════════════════════════════
# AI Agent
# ══════════════════════════════════════════════════════════════════════════

# ── 생성 모델 ────────────────────────────────────────────────────────────
# anthropic | openai
AGENT_LLM_PROVIDER=anthropic
# 비워 두면 제공자별 기본값 (anthropic → claude-sonnet-5, openai → gpt-4.1)
AGENT_LLM_MODEL=

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 임베딩 ──────────────────────────────────────────────────────────────
# 차원은 doc_chunks.embedding vector(1024) 에 DDL 로 고정돼 있다.
# 모델을 바꾸면 전량 재색인이고, 차원까지 달라지면 마이그레이션이다.
# text-embedding-3-large/small 은 dimensions=1024 축소를 지원한다.
AGENT_EMBED_MODEL=text-embedding-3-large
# 임베딩은 OpenAI 만 지원하므로 위 제공자가 anthropic 이어도 이 키가 필요하다.
# OPENAI_API_KEY=

# 🔴 대외비 문서 외부 전송 승인 플래그
#
#   WS-KS-001 작업표준서 · QS-KS-001 품질기준서는 표지에
#   "사내 표준 (대외비 · 무단 복제 및 반출 금지)" 이 찍혀 있다.
#   임베딩과 답변 생성은 이 문서 본문을 외부 API 로 보내는 행위다.
#
#   사업계획서 p.60 §9.2 는 폐쇄형 구조를 요구하고, 외부 API 사용은
#   CR-ARCH-001 승인 대기 상태다.
#
#   승인 + CISO 확인 후에만 1 로 둔다. 값이 없으면 문서 근거를 쓰지 않는다.
AGENT_EXTERNAL_EMBED_APPROVED=

# ── 검색 ────────────────────────────────────────────────────────────────
AGENT_RETRIEVE_K=5

# 🔴 유사도 하한 컷오프 — 환각 방지의 1차 방어선 (§3.6)
#
#   설계서가 "코퍼스 확보 후 실측으로 정한다 — 지금 숫자를 지어내지 않는다" 고
#   못박아 **비워 뒀다.** 비어 있으면 컷오프를 적용하지 않고, 그 사실이
#   agent_runs.retrieval.cutoff = null 로 기록된다.
#
#   실측: .venv/bin/python scripts/measure_cutoff.py
#         (scripts/evalset.py 의 10문항으로 정답/오답 청크 유사도 분포를 뽑는다)
AGENT_SIMILARITY_CUTOFF=

# ── 생성 파라미터 ────────────────────────────────────────────────────────
AGENT_MAX_OUTPUT_TOKENS=1200
# 전역 10초 타임아웃과 별개다 (§7.10). 프론트는 65초를 준다.
AGENT_LLM_TIMEOUT_S=55
AGENT_TEMPERATURE=0
